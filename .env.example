PORT=8000
HOST=0.0.0.0
RELOAD=true
LOG_LEVEL=info

ENVIRONMENT=local
DATABASE_URL=sqlite:///./dental_app.db
LOCAL_UPLOAD_DIR=uploads

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-generated-fernet-key

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_KEY=replace-with-generated-jwt-secret

SEED_DEMO_DATA=true
DEMO_EMAIL=demo@dental-records.dev
DEMO_PASSWORD=DemoPassword123!

CANONICAL_HOST=dental-records.com
REDIRECT_HOSTS=www.dental-records.com,app.dental-records.com,dental-app-39943357835.us-central1.run.app

# Only needed when ENVIRONMENT=cloud.
BUCKET_NAME=
